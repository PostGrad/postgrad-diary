---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts } from '@/lib/posts';
import { withBase } from '@/lib/site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = new Set(posts.flatMap((post) => post.data.tags));

  return [...tags].map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((post) => post.data.tags.includes(tag))
    }
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={`Tag: ${tag}`} description={`Posts tagged ${tag}.`}>
  <section class="page-heading">
    <p class="eyebrow">Tag</p>
    <h1>{tag}</h1>
    <p>{posts.length} post{posts.length === 1 ? '' : 's'} in this topic.</p>
  </section>

  <section class="post-list" aria-label={`Posts tagged ${tag}`}>
    {posts.map((post) => (
      <article class="list-item">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        <h2><a href={withBase(`/blogs/${post.id}`)}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
      </article>
    ))}
  </section>
</BaseLayout>
