---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedPosts } from '@/lib/posts';
import { withBase } from '@/lib/site';

const posts = await getPublishedPosts();
const tagCounts = posts.reduce((counts, post) => {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
  return counts;
}, new Map<string, number>());

const tags = [...tagCounts.entries()].sort(([a], [b]) => a.localeCompare(b));
---

<BaseLayout title="Tags" description="Browse posts by tag.">
  <section class="page-heading">
    <p class="eyebrow">Index</p>
    <h1>Tags</h1>
    <p>Browse posts by topic.</p>
  </section>

  <ul class="tag-cloud" aria-label="Tags">
    {tags.map(([tag, count]) => (
      <li>
        <a href={withBase(`/tags/${tag}`)}>
          <span>{tag}</span>
          <strong>{count}</strong>
        </a>
      </li>
    ))}
  </ul>
</BaseLayout>

