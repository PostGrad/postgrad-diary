---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { AUTHOR_NAME } from '@/lib/site';
---

<BaseLayout title="About" description={`About ${AUTHOR_NAME} and this technical writing site.`}>
  <section class="about-intro">
    <h1>{AUTHOR_NAME}</h1>
    <p class="tagline">Senior Software Engineer · Tech Lead · DevOps · AI Projects</p>
    <p class="summary">
      Five years into building software for a living, now a Senior Software Engineer at Opexil, where my
      job title is really a list of hats: tech lead,
      hands-on developer, DevOps owner and a regular voice in client meetings. I work across the
      platform end to end, from backend and apps to cloud infrastructure and deployments, and I'm
      driving our AI work, including Opeximate. Before this I was a forward-deployed engineer at
      Gupshup and, in a previous life, a professor. I like building reliable software that works for
      real businesses, preferably the kind that lets me sleep through the night.
    </p>
    <nav class="profile-links" aria-label="Profile links">
      <a href="mailto:emailofpranay@gmail.com">email</a>
      <a href="https://linkedin.com/in/postgrad" target="_blank" rel="noopener">linkedin</a>
      <a href="https://github.com/PostGrad" target="_blank" rel="noopener">github</a>
    </nav>
  </section>

  <section class="resume-section">
    <h2>Currently</h2>
    <article class="resume-item">
      <div class="item-header">
        <span class="company">Opexil</span>
        <span class="period">Jun 2026 - present</span>
      </div>
      <p class="role">Senior Software Engineer · Tech Lead · DevOps · AI Projects</p>
      <p class="desc">
        Tech lead, hands-on developer, DevOps owner and a regular voice in client meetings. In practice
        that means the person who wrote the code also explains it to the client, ships it to production
        and picks up the phone when it misbehaves. I work across the platform end to end: backend, web
        and mobile apps, ERP integrations, cloud infrastructure, CI/CD and deployments. Also driving our
        AI work, including Opeximate.
      </p>
    </article>
  </section>

  <section class="resume-section">
    <h2>Previously</h2>
    <article class="resume-item">
      <div class="item-header">
        <span class="company">Gupshup Technology</span>
        <span class="period">2022 - 2026</span>
      </div>
      <p class="role">Senior Software Solution Engineer (Oct 2025 - May 2026) · Software Solution Engineer (Jun 2022 - Sep 2025)</p>
      <p class="desc">
        Forward-deployed engineer working directly with enterprise clients on messaging and automation
        integrations (WhatsApp, Instagram, Web) handling millions of messages a day. Built fault-tolerant
        webhook pipelines with retries and async queues that cut delivery failures by 95%, analytics that
        cut manual reporting by 80%, and query and worker tuning that made APIs 40% faster on 30% less
        infra. Led a team of 6 engineers.
      </p>
    </article>
    <article class="resume-item">
      <div class="item-header">
        <span class="company">BVM Engineering College</span>
        <span class="period">2017 - 2022</span>
      </div>
      <p class="role">Assistant Professor, Computer Engineering</p>
      <p class="desc">
        Taught operating systems, web technology, and cloud computing to 1000+ students. Supervised
        ML/DL projects and helped lead digital transformation during COVID-era remote education.
      </p>
    </article>
    <article class="resume-item">
      <div class="item-header">
        <span class="company">Tata Consultancy Services</span>
        <span class="period">2017</span>
      </div>
      <p class="role">Assistant System Engineer</p>
      <p class="desc">
        Went through TCS's Initial Learning Program on the enterprise Java track: Core Java, Spring Boot,
        REST APIs and SQL. Built backend modules and utility services for training assignments and project
        simulations, and walked out with a 4/5 rating, which by ILP standards is a very good report card.
      </p>
    </article>
  </section>

  <section class="resume-section">
    <h2>Projects</h2>
    <article class="resume-item">
      <div class="item-header">
        <a class="company" href="https://rnscinemas.in/" target="_blank" rel="noopener">R&amp;S Cinemas</a>
      </div>
      <p class="desc">
        Website and staff portal for R&amp;S Cinemas, live at rnscinemas.in. Movies, trailers, online food
        ordering with HDFC payment gateway and receipts, group bookings and student discounts on the public
        side, plus a staff dashboard for movies, screens, canteen menu, requests and user access. Started on
        Next.js and got migrated to React 19 + Vite with an Express and MySQL API, because sometimes the
        best feature is fewer moving parts.
      </p>
    </article>
    <article class="resume-item">
      <div class="item-header">
        <a class="company" href="https://github.com/PostGrad/Publier" target="_blank" rel="noopener">Publier</a>
      </div>
      <p class="desc">
        Developer-first content publishing API for creating, scheduling, and managing content with
        Node.js, TypeScript, PostgreSQL, and Redis.
      </p>
    </article>
    <article class="resume-item">
      <div class="item-header">
        <span class="company">Temple Management Apps</span>
      </div>
      <p class="desc">
        Volunteer web applications for event and temple operations using Next.js, Nest.js, and GraphQL.
      </p>
    </article>
    <article class="resume-item">
      <div class="item-header">
        <a class="company" href="https://github.com/PostGrad/gyanghar-public" target="_blank" rel="noopener">
          Gyan Ghar Dashboard
        </a>
      </div>
      <p class="desc">
        Mobile-first accountability platform for students and administrators in a residential hostel.
      </p>
    </article>
    <article class="resume-item">
      <div class="item-header">
        <span class="company">RAG Chatbot</span>
      </div>
      <p class="desc">
        Retrieval-augmented generation chatbot for contextual Q&amp;A workflows over private knowledge.
      </p>
    </article>
  </section>

  <section class="resume-section">
    <h2>Stack</h2>
    <div class="skills">
      <div class="skill-group">
        <span class="skill-label">languages</span>
        <span class="skill-items">TypeScript, JavaScript, Python, Java</span>
      </div>
      <div class="skill-group">
        <span class="skill-label">backend</span>
        <span class="skill-items">Node.js, Nest.js, Express, Django</span>
      </div>
      <div class="skill-group">
        <span class="skill-label">apis</span>
        <span class="skill-items">REST, GraphQL, Webhooks</span>
      </div>
      <div class="skill-group">
        <span class="skill-label">databases</span>
        <span class="skill-items">PostgreSQL, MongoDB, Redis, MySQL</span>
      </div>
      <div class="skill-group">
        <span class="skill-label">frontend</span>
        <span class="skill-items">React, Next.js, TanStack, Tailwind</span>
      </div>
      <div class="skill-group">
        <span class="skill-label">mobile</span>
        <span class="skill-items">React Native, Expo, Zustand, Redux Toolkit</span>
      </div>
      <div class="skill-group">
        <span class="skill-label">devops</span>
        <span class="skill-items">Linux, Docker, Git, Jenkins, AWS, GCP, Woodpecker</span>
      </div>
    </div>
  </section>

  <section class="resume-section">
    <h2>Education</h2>
    <div class="resume-item compact">
      <span class="degree">M.E. Computer Engineering</span>
      <span class="period">2014 - 2016</span>
    </div>
    <div class="resume-item compact">
      <span class="degree">B.E. Computer Engineering</span>
      <span class="period">2010 - 2014</span>
    </div>
    <p class="note">GATE 2014 - AIR 2739 / GATE 2016 - AIR 5843</p>
  </section>
</BaseLayout>
