---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatDate, getPublishedPosts } from '@/lib/posts';
import { withBase } from '@/lib/site';

const posts = await getPublishedPosts();
---

<BaseLayout title="Blog" description="All technical blog posts.">
  <section class="page-heading">
    <p class="eyebrow">Archive</p>
    <h1>Blogs</h1>
    <p>All published notes, ordered from newest to oldest.</p>
  </section>

  <section class="post-list" aria-label="Blog posts">
    {posts.map((post) => (
      <article class="list-item">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
        <h2><a href={withBase(`/blogs/${post.id}`)}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
      </article>
    ))}
  </section>
</BaseLayout>
