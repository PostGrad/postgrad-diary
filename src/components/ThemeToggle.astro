<button class="theme-toggle" type="button" aria-label="Toggle color theme" title="Toggle color theme">
  <span class="theme-toggle-icon" aria-hidden="true"></span>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('.theme-toggle');

  function getNextTheme() {
    return document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
  }

  function setTheme(theme: 'light' | 'dark') {
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;
    localStorage.setItem('theme', theme);
  }

  button?.addEventListener('click', () => setTheme(getNextTheme()));
</script>

